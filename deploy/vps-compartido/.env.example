# Copy to ~/Mrkos/.env on the VPS and fill in real values. Never commit it.

# Domain whose A record points at the VPS. lawyer-nginx serves it with its own certificate;
# the API uses it for QR links and CORS.
DOMAIN=

# Lawyer's Docker network — check the exact name with `docker network ls` (usually
# lawyer_default) — and the SQL Server container reachable on it.
LAWYER_NETWORK=lawyer_default
SQL_HOST=lawyer-sqlserver-1

# The dedicated login created by deploy/sql/00_CreateDatabaseAndLogin.sql. Not sa.
DB_USER=mrkos
DB_PASSWORD=

# Long random secrets — `openssl rand -base64 48` for each.
QR_SIGNING_KEY=
ADMIN_API_KEY=

# Optional — Telegram alert when a guest requests a song. Leave blank to skip.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
