# DJ MrKos — HTTP only. Used until the Let's Encrypt certificate for __DOMAIN__ exists,
# so lawyer-nginx can answer certbot's challenge without referencing a missing cert.
# Generated by deploy.sh — edit the template in the repo, not ~/Mrkos/nginx/mrkos.conf.

server {
    listen 80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot-mrkos;
    }

    # Resolved per request through Docker's DNS: if the DJ MrKos stack is down, nginx
    # (and with it Lawyer) still starts.
    resolver 127.0.0.11 valid=30s;
    set $mrkos http://mrkos-web:80;

    location / {
        proxy_pass $mrkos;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
