# Copied to ~/Mrkos/.env by deploy.sh on the first run. Never commit it.

# Public domain (its A record points at the VPS). Used for QR links and CORS; HTTPS for
# it is handled by ~/infra/caddy/sites/djmrkos.caddy.
DOMAIN=djmrkos.com

# DJ MrKos's own SQL login, with rights only on the djmrkos database. Create it with
#   bash ~/infra/scripts/app-login.sh mrkos DJMrkos ~/Mrkos/.env
# (it already exists if it was created by hand before ~/infra).
DB_USER=mrkos
DB_PASSWORD=

# Long random secrets — deploy.sh generates both on the first run.
QR_SIGNING_KEY=
ADMIN_API_KEY=

# Optional — Telegram alert when a guest requests a song. Leave blank to skip.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
