# Copy to deploy/.env and fill in real values. Never commit deploy/.env.

# The domain pointed at this VPS (A record). Caddy uses this both as the site address
# and to request its Let's Encrypt certificate — it must be a real, publicly resolvable
# domain, not localhost or a bare IP, or automatic HTTPS will fail.
DOMAIN=djmrkos.com

# SQL Server "sa" password. Must satisfy SQL Server's complexity policy: 8+ chars, and at
# least 3 of upper/lower/digit/symbol.
MSSQL_SA_PASSWORD=ChangeThisStrongPassword!1

# Long random secrets — e.g. `openssl rand -base64 48` for each. QR_SIGNING_KEY signs QR
# tokens (docs/ARCHITECTURE.md#el-flujo-del-qr); ADMIN_API_KEY is the X-Api-Key the DJ's
# admin panel logs in with.
QR_SIGNING_KEY=
ADMIN_API_KEY=

# Optional — free Telegram alert when a guest requests a song (see README.md). Leave blank
# to skip; the app works fine without it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
